---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const lists = (await getCollection('lists')).sort(
  (a, b) => a.data.number - b.data.number,
);
const chapters = (await getCollection('guide')).sort(
  (a, b) => a.data.step - b.data.step,
);
const short = (t: string) => t.replace(/^Step \d+ — /, '');
---
<Base
  title="Lemon Agent — free tools, honest measurements, agentic services"
  description="A field guide for working with coding agents — concrete patterns from measured use, failure lists to check work against, and services agents can call."
>
  <header class="hero">
    <img src="/favicon.svg" alt="" class="hero-mark" />
    <h1 class="wordmark"><span class="chip">LEMON AGENT</span></h1>
    <p class="tagline">free tools · honest measurements · agentic services</p>
    <p class="intro">
      A small house for working with agents. A field guide of patterns
      that survived real use, failure lists to check work against, and
      services agents can call directly. Nothing here earns its place by
      being impressive — only by being used.
    </p>
  </header>

  <h2>The guide</h2>
  <p class="section-note">
    <a href="/guide/">Working with Coding Agents — a field guide</a>:
    what to watch out for and the habits worth building, adopted one
    step at a time. Every step ends with an optional paste-into-Claude
    setup; <a href={`/guide/${chapters[0]?.id}/`}>step 0</a> is the full
    baseline in one paste.
  </p>
  <ol class="toc">
    {chapters.map((ch) => (
      <li>
        <a href={`/guide/${ch.id}/`}>
          <span class="toc-step">{String(ch.data.step).padStart(2, '0')}</span>
          <span class="toc-title">{short(ch.data.title)}</span>
        </a>
      </li>
    ))}
  </ol>

  <h2>The lists</h2>
  <p class="section-note">
    The guide's watch-out reference: numbered failure lists, run as
    subtraction passes. Every match is a cut, a rewrite, or a
    stop-and-fix — never an addition. Each carries a paste-ready prompt
    and installs as a Claude Code skill.
  </p>
  <div class="cards">
    {lists.map((list) => (
      <a class="card" href={`/${list.id}/`}>
        <p class="card-kicker">
          № {list.data.number} · {list.data.prefix}-01…{list.data.prefix}-{String(list.data.entries).padStart(2, '0')}
          <span class={`badge ${list.data.status}`}>{list.data.status}</span>
        </p>
        <p class="card-title">{list.data.title}</p>
        <p class="card-blurb">{list.data.description}</p>
      </a>
    ))}
  </div>

  <h2>The services</h2>
  <div class="cards">
    <a class="card" href="https://pathgrip.net">
      <p class="card-kicker">
        pathgrip.net
        <span class="badge live">live</span>
      </p>
      <p class="card-title">pathgrip</p>
      <p class="card-blurb">
        A bookmark store that keeps a copy of what you saved — and can tell
        you who saved it. Content-addressed snapshots, drift detection,
        per-agent tokens, an MCP surface.
      </p>
      <p class="card-note">
        Honest status: runs as the operator's instance today. Public docs and
        self-serve keys are the next member to ship — until then there's
        nothing here for you to sign up for, and this card says so rather
        than pretending otherwise.
      </p>
    </a>
  </div>
</Base>

<style>
  .hero { margin-bottom: 2.2rem; }
  .hero-mark { width: 3rem; height: 3rem; margin-bottom: 0.7rem; }
  .wordmark {
    font-size: 1.5rem;
    letter-spacing: 0.14em;
    margin: 0;
  }
  .wordmark .chip { padding: 0.08em 0.5em; }
  .tagline {
    color: var(--muted);
    margin: 0.55rem 0 1.3rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .intro { max-width: 40rem; }

  .section-note { color: var(--muted); font-size: 0.85rem; margin-top: 0; }

  .toc { list-style: none; padding: 0; margin: 1rem 0 0.5rem; display: grid; gap: 0.55rem; }
  .toc a {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    text-decoration: none;
  }
  .toc a:hover .toc-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .toc-step {
    color: var(--chip-ink);
    background: var(--chartreuse);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.05em 0.4em;
    letter-spacing: 0.06em;
  }
  .toc-title { font-weight: 700; color: var(--accent-ink); }

  .cards { display: grid; gap: 0.9rem; margin: 1.1rem 0 0.5rem; }
  .card {
    display: block;
    padding: 1rem 1.2rem;
    background: var(--card);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, background 120ms ease, box-shadow 120ms ease;
  }
  .card:hover {
    border-color: var(--border-hover);
    background: var(--card-hover);
    box-shadow: var(--glow);
  }
  .card-kicker {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .card-title { margin: 0.3rem 0 0.25rem; font-weight: 700; font-size: 1.05rem; color: var(--accent-ink); }
  .card-blurb { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .card-note {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
    border-top: 1px dashed var(--border);
    padding-top: 0.6rem;
  }
</style>
