---
import Base from '../../layouts/Base.astro';
import ToolChooser from '../../components/ToolChooser.astro';
import CourseClient from '../../components/CourseClient.astro';
import { START_LESSONS } from '../../lib/start.mjs';

const totalMinutes = START_LESSONS.reduce((sum, lesson) => sum + lesson.minutes, 0);
---

<Base
  wide
  title="Start here · Learn to work with a coding agent"
  description="A seven-lesson, hands-on introduction to scoping, guiding, verifying, and reviewing work with a coding agent."
>
  <section class="course-hero">
    <div>
      <p class="eyebrow">Start here · {START_LESSONS.length} short lessons</p>
      <h1>Your first coding-agent session, without the leap of faith.</h1>
      <p class="hero-copy">
        Learn how to give an agent a safe job, keep the important decisions,
        and verify what changed. It starts from experience with chat tools,
        explains the mechanics directly, and stays useful as your technical
        work becomes more ambitious.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`/start/${START_LESSONS[0].id}/`}>Start lesson 1</a>
        <span>About {totalMinutes} minutes · progress stays on this device</span>
      </div>
    </div>
    <aside class="course-promise" aria-label="What you will practice">
      <p class="promise-kicker">The working loop</p>
      <ol>
        <li><span>1</span><div><strong>Scope</strong><small>Give the work a boundary.</small></div></li>
        <li><span>2</span><div><strong>Plan</strong><small>Expose assumptions before edits.</small></div></li>
        <li><span>3</span><div><strong>Act</strong><small>Let the agent move inside the boundary.</small></div></li>
        <li><span>4</span><div><strong>Verify</strong><small>Ask for evidence, not confidence.</small></div></li>
        <li><span>5</span><div><strong>Review</strong><small>Judge the artifact and save a checkpoint.</small></div></li>
      </ol>
    </aside>
  </section>

  <section class="setup-strip">
    <div>
      <strong>Use the tool you already have.</strong>
      <p>The lessons teach one workflow. We adjust the handoff language to match your agent.</p>
    </div>
    <ToolChooser />
  </section>

  <section class="course-section" aria-labelledby="lessons-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The course</p>
        <h2 id="lessons-title">Seven decisions worth practicing</h2>
      </div>
      <div class="course-progress">
        <span><strong data-progress-count>0 of {START_LESSONS.length}</strong> complete</span>
        <div aria-hidden="true"><i data-progress-bar></i></div>
        <button type="button" data-reset-progress>Reset</button>
      </div>
    </div>
    <ol class="lesson-grid">
      {START_LESSONS.map((lesson) => (
        <li data-lesson-id={lesson.id}>
          <a href={`/start/${lesson.id}/`}>
            <span class="lesson-number">{String(lesson.step).padStart(2, '0')}</span>
            <div>
              <h3>{lesson.title}</h3>
              <p>{lesson.description}</p>
              <span class="lesson-meta">{lesson.minutes} min <b class="lesson-done">· complete ✓</b></span>
            </div>
            <span class="lesson-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="after-course">
    <p class="eyebrow">After the course</p>
    <h2>Keep the field manual nearby.</h2>
    <p>
      Go deeper on verification, Git, durable agent instructions, CLI/API/MCP
      choices, reusable skills, and small deterministic tools.
    </p>
    <a href="/guides/">Browse the field manual →</a>
  </section>
  <CourseClient />
</Base>

<style>
  .course-hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; padding: 2rem 0 4.5rem; }
  .eyebrow { margin: 0 0 0.7rem; color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  h1 { max-width: 13ch; }
  .hero-copy { max-width: 40rem; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.22rem); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.7rem; }
  .hero-actions > span { color: var(--muted); font-size: 0.82rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; padding: 0.72rem 1rem; border: 1px solid var(--border-hover); border-radius: 0.42rem; font-weight: 750; text-decoration: none; }
  .button.primary { background: var(--chartreuse); color: var(--chip-ink); }
  .button:hover { transform: translateY(-1px); }
  .course-promise { padding: 1.3rem; border: 1px solid var(--border); border-radius: 0.8rem; background: var(--card); box-shadow: var(--glow); }
  .promise-kicker { margin: 0 0 0.8rem; color: var(--muted); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .course-promise ol { list-style: none; margin: 0; padding: 0; }
  .course-promise li { display: grid; grid-template-columns: 1.8rem 1fr; gap: 0.75rem; padding: 0.65rem 0; border-top: 1px solid var(--border); }
  .course-promise li > span { color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-weight: 750; }
  .course-promise strong, .course-promise small { display: block; }
  .course-promise small { color: var(--muted); margin-top: 0.1rem; }
  .setup-strip { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-bottom: 5rem; padding: 1.2rem 1.4rem; border: 1px solid var(--border); border-radius: 0.7rem; background: var(--note-bg); }
  .setup-strip p { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.88rem; }
  .course-section { margin-bottom: 5rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 1.5rem; }
  .section-heading h2, .after-course h2 { margin: 0; color: var(--ink); font-size: clamp(1.7rem, 4vw, 2.4rem); letter-spacing: -0.035em; text-transform: none; }
  .section-heading h2::before, .after-course h2::before { content: none; }
  .course-progress { min-width: 12rem; color: var(--muted); font-size: 0.78rem; }
  .course-progress > div { height: 0.32rem; margin: 0.35rem 0; overflow: hidden; border-radius: 1rem; background: var(--code-bg); }
  .course-progress i { display: block; width: 0; height: 100%; background: var(--chartreuse); transition: width 180ms ease; }
  .course-progress button { padding: 0; border: 0; background: transparent; color: var(--accent-ink); font: inherit; cursor: pointer; }
  .lesson-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; list-style: none; margin: 0; padding: 0; }
  .lesson-grid li:first-child { grid-column: 1 / -1; }
  .lesson-grid a { display: grid; grid-template-columns: 2.2rem 1fr 1.3rem; gap: 0.9rem; height: 100%; padding: 1.15rem; border: 1px solid var(--border); border-radius: 0.65rem; background: var(--card); color: inherit; text-decoration: none; }
  .lesson-grid a:hover { border-color: var(--border-hover); background: var(--card-hover); box-shadow: var(--glow); }
  .lesson-number { color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.75rem; font-weight: 800; }
  .lesson-grid h3 { margin: 0; color: var(--ink); font-size: 1.04rem; }
  .lesson-grid p { margin: 0.35rem 0 0.6rem; color: var(--muted); font-size: 0.88rem; }
  .lesson-meta { color: var(--muted); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.7rem; text-transform: uppercase; }
  .lesson-done { display: none; color: var(--live-ink); }
  .lesson-grid li.complete .lesson-done { display: inline; }
  .lesson-arrow { align-self: center; color: var(--accent-ink); }
  .after-course { max-width: 44rem; padding: 2rem 0; }
  .after-course p:not(.eyebrow) { color: var(--muted); }
  @media (max-width: 48rem) {
    .course-hero { grid-template-columns: 1fr; padding-top: 0; }
    .course-promise { max-width: 32rem; }
    .setup-strip, .section-heading { align-items: flex-start; flex-direction: column; }
    .lesson-grid { grid-template-columns: 1fr; }
    .lesson-grid li:first-child { grid-column: auto; }
  }
</style>
