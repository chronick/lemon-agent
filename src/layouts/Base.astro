---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{isHome ? title : `${title} · Lemon Agent`}</title>
  </head>
  <body>
    <main>
      {!isHome && (
        <nav class="crumb">
          <a href="/"><img src="/favicon.svg" alt="" class="mark" /> LEMON AGENT</a>
        </nav>
      )}
      <slot />
      <footer>
        <p>
          <span class="chip">LEMON AGENT</span> free tools · honest
          measurements · agentic services.
        </p>
        <p>
          House rule: nothing ships without a working answer to
          <em>"how would you actually use this?"</em>
        </p>
        <p>
          Provenance: mostly AI-generated, human-guided and reviewed.
        </p>
        <p class="agents">
          For agents: <a href="/catalog.json">catalog.json</a> ·
          <a href="/llms.txt">llms.txt</a> · raw markdown under
          <code>/lists/</code>
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  /* LEMON AUDIO visual language, light rendition.
     Dark mode is the native LEMON AUDIO look (deep space + chartreuse glow). */
  :root {
    --chartreuse: #ccff00;
    --bg: #fafaf4;
    --ink: #16170f;
    --muted: #6b6e5a;
    --accent-ink: #5b6e00;
    --border: rgba(22, 23, 15, 0.16);
    --border-hover: #a9c400;
    --card: #ffffff;
    --card-hover: rgba(204, 255, 0, 0.07);
    --note-bg: rgba(204, 255, 0, 0.09);
    --code-ink: #3d4030;
    --code-bg: rgba(22, 23, 15, 0.06);
    --term-bg: #0a0a0f;
    --term-ink: #e0e0e0;
    --chip-ink: #0a0a0f;
    --live-ink: #1d6b1d;
    --live-bg: rgba(57, 255, 20, 0.16);
    --glow: none;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0f;
      --ink: #e0e0e0;
      --muted: #7d8195;
      --accent-ink: #ccff00;
      --border: rgba(204, 255, 0, 0.15);
      --border-hover: #ccff00;
      --card: rgba(204, 255, 0, 0.02);
      --card-hover: rgba(204, 255, 0, 0.06);
      --note-bg: rgba(204, 255, 0, 0.05);
      --code-ink: #cdd0b8;
      --code-bg: rgba(204, 255, 0, 0.08);
      --live-ink: #39ff14;
      --live-bg: rgba(57, 255, 20, 0.1);
      --glow: 0 0 8px rgba(204, 255, 0, 0.4), 0 0 24px rgba(204, 255, 0, 0.15);
    }
  }

  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    font-family: Menlo, Monaco, Consolas, 'Courier New', monospace;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink);
    -webkit-text-size-adjust: 100%;
  }
  ::selection { background: var(--chartreuse); color: #0a0a0f; }
  main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }

  a { color: var(--accent-ink); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }

  h1 {
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
    margin: 0.4rem 0 1rem;
  }
  h2 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2.6rem 0 0.7rem;
  }
  h2::before { content: '// '; color: var(--accent-ink); }

  code {
    font-family: inherit;
    font-size: 0.92em;
    background: var(--code-bg);
    color: var(--code-ink);
    padding: 0.08em 0.35em;
  }
  /* Fenced blocks render as terminals in both themes: the brand's home turf */
  pre {
    background: var(--term-bg);
    color: var(--term-ink);
    border: 1px solid var(--border);
    padding: 0.85rem 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  pre code { background: none; color: inherit; padding: 0; font-size: inherit; }

  .chip {
    display: inline-block;
    background: var(--chartreuse);
    color: var(--chip-ink);
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.05em 0.45em;
  }

  .crumb { margin-bottom: 1.6rem; }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
  }
  .crumb a:hover { color: var(--accent-ink); }
  .mark { width: 1.15em; height: 1.15em; }

  .kicker {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.1em 0.5em;
  }
  .badge.draft { color: var(--chip-ink); background: var(--chartreuse); }
  .badge.live, .badge.published { color: var(--live-ink); background: var(--live-bg); }

  /* Rendered list body */
  .list-body blockquote {
    margin: 1.4rem 0;
    padding: 0.75rem 1.1rem;
    border-left: 2px solid var(--chartreuse);
    background: var(--note-bg);
    font-size: 0.9rem;
  }
  .list-body blockquote p { margin: 0.4rem 0; }
  .list-body ol { padding-left: 1.5rem; }
  .list-body ol li { margin: 0.9rem 0; }
  .list-body hr { border: 0; border-top: 1px solid var(--border); margin: 2.5rem 0 1.5rem; }
  .list-body hr ~ p { color: var(--muted); font-size: 0.85rem; }

  /* Interactive examples: CSS-only (radio + sibling selectors) */
  .xmpl {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 1rem 1.1rem;
    margin: 1.6rem 0;
    font-size: 0.88rem;
  }
  .xmpl-head { margin: 0 0 0.9rem; font-weight: 700; letter-spacing: 0.03em; }
  .xmpl-head .chip { font-size: 0.68rem; margin-right: 0.3em; }
  .xmpl-turn { display: flex; gap: 0.7em; margin: 0.55rem 0; }
  .xmpl-role {
    flex: 0 0 3.2em;
    text-align: right;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.35em;
  }
  .xmpl-turn-agent .xmpl-role { color: var(--accent-ink); }
  .xmpl-text {
    flex: 1;
    border: 1px solid var(--border);
    padding: 0.45rem 0.7rem;
    background: var(--bg);
  }
  .xmpl-turn-agent .xmpl-text { border-left: 2px solid var(--chartreuse); }
  .xmpl-text p { margin: 0.3rem 0; }
  .xmpl-q { margin: 1.1rem 0 0.6rem; font-weight: 700; }
  .xmpl-q::before { content: '// '; color: var(--accent-ink); }
  .xmpl-radio { position: absolute; opacity: 0; pointer-events: none; }
  .xmpl-opt {
    display: flex;
    gap: 0.7em;
    align-items: baseline;
    border: 1px solid var(--border);
    background: var(--bg);
    padding: 0.55rem 0.75rem;
    margin: 0.45rem 0;
    cursor: pointer;
  }
  .xmpl-opt:hover { border-color: var(--border-hover); }
  .xmpl-radio:focus-visible + .xmpl-opt { outline: 2px solid var(--chartreuse); }
  .xmpl-radio:checked + .xmpl-opt {
    border-color: var(--border-hover);
    background: var(--card-hover);
  }
  .xmpl-key {
    flex: 0 0 auto;
    color: var(--chip-ink);
    background: var(--chartreuse);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.05em 0.45em;
  }
  .xmpl-outcome { display: none; margin: 0.3rem 0 1rem 1.5rem; }
  .xmpl-radio:checked + .xmpl-opt + .xmpl-outcome { display: block; }
  .xmpl-verdict {
    border: 1px solid var(--border);
    border-left-width: 2px;
    padding: 0.5rem 0.75rem;
    margin-top: 0.7rem;
  }
  .xmpl-verdict p { margin: 0.35rem 0 0; }
  .xmpl-verdict-chip {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.08em 0.5em;
  }
  .xmpl-verdict-correct { border-left-color: var(--chartreuse); }
  .xmpl-verdict-correct .xmpl-verdict-chip { background: var(--chartreuse); color: var(--chip-ink); }
  .xmpl-verdict-baseline { border-left-color: var(--muted); }
  .xmpl-verdict-baseline .xmpl-verdict-chip { background: var(--muted); color: var(--bg); }
  .xmpl-verdict-plausible { border-left-color: var(--live-ink); }
  .xmpl-verdict-plausible .xmpl-verdict-chip { background: var(--live-bg); color: var(--live-ink); }
  .xmpl-cites a { color: var(--muted); font-size: 0.8rem; }

  footer {
    margin-top: 4rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8rem;
  }
  footer p { margin: 0.45rem 0; }
  footer .chip { font-size: 0.7rem; }

  .backlink { margin-top: 2.5rem; font-size: 0.85rem; }
</style>
