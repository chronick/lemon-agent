---
import { START_LESSONS } from '../lib/start.mjs';
import ToolChooser from './ToolChooser.astro';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<aside class="course-sidebar" aria-label="Course progress">
  <div class="sidebar-top">
    <p class="sidebar-kicker">Start here</p>
    <p><strong data-progress-count>0 of {START_LESSONS.length}</strong> complete</p>
    <div class="progress-track" aria-hidden="true"><span data-progress-bar></span></div>
  </div>
  <ol>
    {START_LESSONS.map((lesson) => (
      <li data-lesson-id={lesson.id} class:list={{ current: current === lesson.id }}>
        <a href={`/start/${lesson.id}/`} aria-current={current === lesson.id ? 'step' : undefined}>
          <span class="lesson-number">{lesson.step}</span>
          <span>{lesson.short}</span>
          <span class="lesson-check" aria-hidden="true">✓</span>
        </a>
      </li>
    ))}
  </ol>
  <ToolChooser compact />
</aside>

<style>
  .course-sidebar {
    position: sticky;
    top: 1.25rem;
    align-self: start;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--card);
  }
  .sidebar-kicker {
    margin: 0;
    color: var(--accent-ink);
    font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sidebar-top > p:last-of-type { margin: 0.25rem 0 0.55rem; color: var(--muted); font-size: 0.8rem; }
  .progress-track { height: 0.32rem; overflow: hidden; border-radius: 1rem; background: var(--code-bg); }
  .progress-track span { display: block; width: 0; height: 100%; background: var(--chartreuse); transition: width 180ms ease; }
  ol { list-style: none; padding: 0; margin: 1rem 0 1.25rem; border-top: 1px solid var(--border); }
  li { border-bottom: 1px solid var(--border); }
  a { display: grid; grid-template-columns: 1.4rem 1fr 1rem; gap: 0.45rem; align-items: center; padding: 0.56rem 0; color: var(--muted); text-decoration: none; font-size: 0.82rem; }
  li.current a { color: var(--ink); font-weight: 750; }
  a:hover { color: var(--accent-ink); }
  .lesson-number { font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; color: var(--accent-ink); }
  .lesson-check { visibility: hidden; color: var(--live-ink); font-weight: 800; }
  li.complete .lesson-check { visibility: visible; }
  @media (max-width: 52rem) {
    .course-sidebar { position: static; }
    ol { display: grid; grid-template-columns: repeat(7, minmax(2.1rem, 1fr)); gap: 0.35rem; border: 0; }
    li { border: 0; }
    a { display: flex; justify-content: center; min-height: 2.4rem; border: 1px solid var(--border); border-radius: 0.35rem; padding: 0.4rem; }
    a > span:nth-child(2) { display: none; }
    .lesson-check { position: absolute; transform: translate(0.65rem, -0.75rem); }
  }
</style>
